# 複製這個檔案為 django/.env 再填入實際數值：
#   cp django/.env.example django/.env
#
# .env 已被 .gitignore 排除，絕對不要提交。這個 repo 是公開的，
# 實際的密碼與金鑰請透過私訊向組員索取，不要貼在 issue、PR 或公開群組。
# project115208/settings.py 啟動時會自動讀取 django/.env（不需要安裝 python-dotenv）。

# ---- Django ----
# 產生新的 key：
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=
# 本機開發用 1；正式部署請設 0（設 0 時錯誤頁不會洩漏程式碼與設定）
DJANGO_DEBUG=1
# 逗號分隔。本機開發（含 ngrok 測 LINE 登入）可用 *；正式部署請改成實際網域
DJANGO_ALLOWED_HOSTS=*

# ---- MySQL（主資料庫，必填）----
MYSQL_NAME=
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_HOST=
MYSQL_PORT=3306

# ---- 社群登入 ----
# LINE Developers Console > 你的 channel > Basic settings
LINE_CLIENT_ID=
LINE_CLIENT_SECRET=
# Google Cloud Console > API 和服務 > 憑證 > OAuth 用戶端 ID
# GOOGLE_CLIENT_ID 同時給登入頁的 Google 按鈕（GSI）與 allauth 帳號綁定使用
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- n8n webhook（AI 問答與成長助理；未設定時沿用程式內的預設值）----
# N8N_RAG_WEBHOOK_URL=
# N8N_RAG_TIMEOUT_SECONDS=60
# N8N_ASSISTANT_WEBHOOK_URL=

# ---- Supabase（RAG 向量庫與紀錄照片）----
SUPABASE_PROJECT_REF=
SUPABASE_URL=
SUPABASE_STORAGE_BUCKET=record-photos
# 僅限後端使用。這把 key 可繞過所有 RLS，絕不可出現在瀏覽器端 JavaScript。
SUPABASE_SERVICE_ROLE_KEY=

# 供 RAG 資料/scripts/pregnancy_rag_ingest.py 在 --write-supabase 時使用
SUPABASE_PG_HOST=
SUPABASE_PG_PORT=5432
SUPABASE_PG_DB=postgres
SUPABASE_PG_USER=
SUPABASE_PG_PASSWORD=
SUPABASE_PG_SSLMODE=require
